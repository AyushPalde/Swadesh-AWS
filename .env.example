# ==============================================================================
# SWADESH Platform Environment Variables (Reference Template)
# Single Source of Truth: docs/BLUEPRINT.md (Section 9)
# ==============================================================================

# Frontend (Vite + React)
VITE_API_BASE_URL=http://localhost:3000
VITE_USE_MOCK=true

# Backend (AWS Lambda / Local Node.js API)
DATA_STORE=memory                # memory | dynamo
S3_MODE=local                    # local | aws
LOG_LEVEL=info                   # debug | info | warn | error

# AWS Resource Names (when deployed or running with AWS SDK)
AWS_REGION=us-east-1
ISSUES_TABLE=swadesh-issues
USERS_TABLE=swadesh-users
IMAGE_BUCKET=swadesh-issue-images

# Security & Credentials
JWT_SECRET=swadesh-dev-secret-replace-in-production
AUTHORITY_PASSCODE=SWADESH-OFFICER-2026

