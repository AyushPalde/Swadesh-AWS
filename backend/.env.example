# ==============================================================================
# SWADESH Backend Environment Configuration (Local Safe Defaults)
# Single Source of Truth: docs/BLUEPRINT.md (Section 9)
# ==============================================================================

# Data persistence store ('memory' for zero-cloud local testing, 'dynamo' for AWS)
DATA_STORE=memory

# Image storage backend ('local' for dev-server filesystem streaming, 'aws' for S3)
S3_MODE=local

# Secret key used for signing HS256 JWT tokens (change in production!)
JWT_SECRET=dev-secret-change-me

# Authority triage portal passcode required during authority login
AUTHORITY_PASSCODE=swadesh-demo

# Logging verbosity level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=DEBUG

# DynamoDB table names (used when DATA_STORE=dynamo)
ISSUES_TABLE=swadesh-issues
USERS_TABLE=swadesh-users

# S3 Bucket name for grievance photos (used when S3_MODE=aws)
IMAGE_BUCKET=local

# AWS Region
AWS_REGION=us-east-1

# Local dev server port
PORT=3001

